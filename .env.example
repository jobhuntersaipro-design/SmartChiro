# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth
AUTH_SECRET="replace-me"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_MONTHLY=""

# Gemini
GEMINI_API_KEY=""

# Anthropic (X-ray AI landmark detection — trial)
ANTHROPIC_API_KEY=""

SKIP_EMAIL_VERIFICATION=false
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Seed
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=

# Appointment reminders
CRON_SECRET=replace-me
RESEND_REMINDERS_FROM=reminders@smartchiro.org

# WhatsApp reminders — Meta Cloud API (context/features/whatsapp-cloud-api-spec.md)
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business → Configurations → WhatsApp Embedded Signup config id
META_WA_CONFIG_ID=
META_GRAPH_VERSION=v23.0
# Any random string; paste the same value in the Meta app's webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-me
# Optional: 64 hex chars (openssl rand -hex 32). Defaults to a key derived from AUTH_SECRET
WHATSAPP_TOKEN_KEY=

# Legacy WhatsApp worker (Baileys) — unused since the Cloud API switch

WORKER_URL=https://wa-worker.example.com
WORKER_SHARED_SECRET=replace-me
WORKER_OUTBOUND_SECRET=replace-me

# Smoke testing (operator-local only)
SMOKE_BRANCH_ID=
SMOKE_PHONE_NUMBER=
