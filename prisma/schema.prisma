generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Models ───

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?
  image         String?
  phoneNumber   String?

  isPro                Boolean @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  /// End of the free trial; every new account gets 30 days (src/lib/subscription.ts).
  trialEndsAt           DateTime? @default(dbgenerated("(now() + '30 days'::interval)"))
  /// Stripe subscription status (active, trialing, past_due, canceled…), kept in sync by the webhook.
  subscriptionStatus    String?
  /// "month" or "year".
  subscriptionInterval  String?
  subscriptionPeriodEnd DateTime?
  /// X-rays this user may run AI analysis on per clinic day; super admins change it.
  aiDailyLimit          Int       @default(10)
  /// Set by a super admin to block sign-in.
  disabledAt            DateTime?
  /// Login activity for the super admin page (src/lib/login-activity.ts).
  lastLoginAt           DateTime?
  loginCount            Int       @default(0)
  /// Last dashboard visit, written at most once an hour.
  lastActiveAt          DateTime?

  activeBranchId String?
  /// Owner/admin of 2+ branches working across all of them ("All branches" in the sidebar).
  allBranches    Boolean @default(false)

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  branchMemberships   BranchMember[]

  // Doctor profile (one-to-one, optional)
  doctorProfile DoctorProfile?

  // As doctor
  assignedPatients    Patient[]              @relation("PatientDoctor")
  visits              Visit[]                @relation("VisitDoctor")
  appointments        Appointment[]          @relation("AppointmentDoctor")
  uploadedXrays       Xray[]                 @relation("XrayUploader")
  annotations         Annotation[]           @relation("AnnotationCreator")
  xrayNotes           XrayNote[]             @relation("XrayNoteAuthor")
  timeOff             DoctorTimeOff[]        @relation("DoctorTimeOff")
  breakTimes          DoctorBreakTime[]      @relation("DoctorBreakTime")
  landmarkCorrections AiLandmarkCorrection[] @relation("AiLandmarkCorrectionUser")
  carePlans           CarePlan[]             @relation("CarePlanDoctor")
  appointmentSeries   AppointmentSeries[]    @relation("SeriesDoctor")
  paymentsReceived    Payment[]              @relation("PaymentReceivedBy")
  einvoiceSubmissions EInvoiceSubmission[]   @relation("EInvoiceSubmittedBy")
  aiUsage             AiUsage[]
  billingBranches     Branch[]               @relation("BranchBillingUser")
  branchInvites       BranchInvite[]         @relation("BranchInviteUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

/// One AI pelvis analysis that succeeded; the daily limit counts distinct X-rays per clinic day.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xrayId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

// ─── Enums ───

enum BranchRole {
  OWNER
  ADMIN
  DOCTOR
  FRONT_DESK
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Who created the appointment: clinic staff, or the patient via the public booking link.
enum AppointmentSource {
  STAFF
  ONLINE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum XrayStatus {
  UPLOADING // presigned URL generated, file not yet confirmed
  READY // upload confirmed, available for annotation
  ARCHIVED // soft-deleted / hidden from active views
}

enum BodyRegion {
  CERVICAL
  THORACIC
  LUMBAR
  PELVIS
  FULL_SPINE
  EXTREMITY
  OTHER
}

enum ViewType {
  AP // anterior-posterior
  LATERAL
  OBLIQUE
  PA // posterior-anterior
  OTHER
}

enum ReminderChannel {
  WHATSAPP
  EMAIL
  BOTH
  NONE
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum WaSessionStatus {
  DISCONNECTED
  PAIRING
  CONNECTED
  LOGGED_OUT
}

// ─── Organization ───

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?
  city    String?
  state   String?
  zip     String?
  phone   String?
  email   String?
  logo    String?

  // Practitioner / business
  ownerName      String?
  licenseNumber  String? // Business license or NPI
  operatingHours String? // e.g. "Mon-Fri 9am-6pm"
  treatmentRooms Int?
  clinicType     String? // solo, group, franchise

  // Nice-to-have
  website             String?
  insuranceProviders  String? // comma-separated
  specialties         String? // comma-separated
  billingContactName  String?
  billingContactEmail String?
  billingContactPhone String?

  // Billing & tax (Phase 4) — printed on invoices and receipts
  legalName           String?
  ssmRegNo            String?
  tin                 String?
  sstRegNo            String?
  sstEnabled          Boolean @default(false)
  sstRate             Decimal @default(6) @db.Decimal(5, 2)
  invoicePrefix       String?
  paymentInstructions String?
  // Per-branch number sequences, bumped atomically (UPDATE ... RETURNING)
  invoiceSeq          Int     @default(0)
  receiptSeq          Int     @default(0)

  // Online booking (Phase 7.1) — public page /book/[bookingSlug]
  bookingEnabled     Boolean         @default(false)
  bookingSlug        String?         @unique
  bookingLeadMinutes Int             @default(120)
  bookingHorizonDays Int             @default(30)
  bookingSlotMinutes Int             @default(15)
  // Empty = the default treatment set / every clinician of the branch
  bookingTreatments  TreatmentType[]
  bookingDoctorIds   String[]
  bookingNote        String?
  // Patient portal (Phase 7.2): patients may cancel online up to this many hours before the start.
  portalCancelHours  Int             @default(24)
  // Accounting export (Phase 8.3) — chart-of-account codes; null = default in src/lib/accounting-export.ts
  acctSales          String?
  acctSst            String?
  acctReceivable     String?
  acctCash           String?
  acctBank           String?
  acctCard           String?
  acctEwallet        String?
  acctPanel          String?

  commissionRules  CommissionRule[]
  // LHDN MyInvois e-invoicing (Phase 8.4). Address, phone and email reuse the
  // fields above; the state code is derived from `state` (+ city/postcode).
  msicCode         String?
  businessActivity String?
  einvoiceEnabled  Boolean          @default(false)

  members      BranchMember[]
  invites      BranchInvite[]

  /// The account whose SmartChiro plan pays for this branch: whoever created it.
  /// Ownership transfers don't move it, so nobody can hand their bill to someone else.
  billingUserId String?
  billingUser   User?   @relation("BranchBillingUser", fields: [billingUserId], references: [id], onDelete: SetNull)
  patients     Patient[]
  appointments Appointment[]
  invoices     Invoice[]
  payments     Payment[]

  doctorTimeOff   DoctorTimeOff[]   @relation("BranchTimeOff")
  doctorBreakTime DoctorBreakTime[] @relation("BranchBreakTime")

  reminderSettings BranchReminderSettings?
  waSession        WaSession?
  whatsAppAccount  WhatsAppAccount?

  packageTemplates  PackageTemplate[]
  patientPackages   PatientPackage[]
  carePlans         CarePlan[]
  appointmentSeries AppointmentSeries[]

  outreach PatientOutreach[]

  einvoiceSubmissions EInvoiceSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Adding an existing account to a branch: they join only when they accept,
/// so one clinic can't attach another clinic's doctor and read their records.
model BranchInvite {
  id          String     @id @default(cuid())
  role        BranchRole
  userId      String
  user        User       @relation("BranchInviteUser", fields: [userId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  invitedById String?
  createdAt   DateTime   @default(now())

  @@unique([userId, branchId])
}

model BranchMember {
  id   String     @id @default(cuid())
  role BranchRole @default(DOCTOR)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@index([role])
}

// ─── Branch Audit Log ───

enum BranchAuditAction {
  CREATE
  UPDATE
  DELETE
}

// ─── Appointment Audit Log ───

enum AppointmentAuditAction {
  CREATE
  UPDATE
  DELETE
  CANCEL
  RESCHEDULE
  DOCTOR_REASSIGN
  STATUS_CHANGE
  NOTE_EDIT
}

model AppointmentAuditLog {
  id            String                 @id @default(cuid())
  appointmentId String
  action        AppointmentAuditAction

  actorId    String?
  actorEmail String
  actorName  String?

  // Snapshot of patient + doctor + time at the moment the event happened so logs stay
  // readable even if the appointment is later deleted.
  patientNameAtEvent String
  dateTimeAtEvent    DateTime

  // Per-field changes for UPDATE/RESCHEDULE/STATUS_CHANGE/NOTE_EDIT/DOCTOR_REASSIGN.
  // Shape: { fieldName: { from: any, to: any } }
  changes Json

  createdAt DateTime @default(now())

  @@index([appointmentId, createdAt(sort: Desc)])
  @@index([actorId])
}

// ─── Treatment Type ───

enum TreatmentType {
  INITIAL_CONSULT
  ADJUSTMENT
  GONSTEAD
  DIVERSIFIED
  ACTIVATOR
  DROP_TABLE
  SOFT_TISSUE
  SPINAL_DECOMPRESSION
  REHAB_EXERCISE
  X_RAY
  FOLLOW_UP
  WELLNESS_CHECK
  PEDIATRIC
  PRENATAL
  SPORTS_REHAB
  OTHER
}

// ─── Doctor Availability ───

enum LeaveType {
  ANNUAL_LEAVE
  SICK_LEAVE
  PERSONAL_LEAVE
  CONFERENCE
  JURY_DUTY
  UNPAID_LEAVE
  OTHER
}

model DoctorTimeOff {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("DoctorTimeOff", fields: [userId], references: [id], onDelete: Cascade)
  // Optional branch scope — null means applies across all branches the doctor works in.
  branchId  String?
  branch    Branch?   @relation("BranchTimeOff", fields: [branchId], references: [id], onDelete: SetNull)
  type      LeaveType
  startDate DateTime
  endDate   DateTime
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([branchId])
  @@index([startDate])
  @@index([endDate])
}

model DoctorBreakTime {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation("DoctorBreakTime", fields: [userId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch  @relation("BranchBreakTime", fields: [branchId], references: [id], onDelete: Cascade)
  // 0 = Sunday … 6 = Saturday (matches JS getDay())
  dayOfWeek   Int
  // Minutes since midnight (e.g., 12:00 PM = 720)
  startMinute Int
  endMinute   Int
  label       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, branchId, dayOfWeek, startMinute])
  @@index([userId, branchId, dayOfWeek])
}

model BranchAuditLog {
  id       String            @id @default(cuid())
  branchId String
  action   BranchAuditAction

  actorId    String?
  actorEmail String
  actorName  String?

  branchNameAtEvent String

  changes Json

  createdAt DateTime @default(now())

  @@index([branchId, createdAt(sort: Desc)])
  @@index([actorId])
}

// ─── Doctor Profile ───

model DoctorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Professional
  licenseNumber   String?
  specialties     String[]
  yearsExperience Int?
  education       String?

  // Clinic-Specific
  workingSchedule Json?
  treatmentRoom   String?
  consultationFee Decimal?

  // Optional
  bio            String?
  languages      String[]
  insurancePlans String[]

  // Practising certificates (T&CM Act 2016, Phase 8.1). apcExpiresAt is a
  // calendar date stored at 00:00 UTC; apcAlertStage is the last alert
  // threshold emailed (60 / 30 / 7 / 0), cleared when the expiry changes.
  tcmRegistrationNo String?
  apcNumber         String?
  apcExpiresAt      DateTime?
  apcAlertStage     Int?

  // System
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Patient & Clinical ───

model Patient {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  email            String?   @unique
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  emergencyContact String?
  medicalHistory   String?
  notes            String?

  // New fields
  icNumber       String? @unique
  occupation     String?
  race           String?
  maritalStatus  String?
  bloodType      String?
  allergies      String?
  referralSource String?

  // Pricing (RM)
  initialTreatmentFee Float?
  firstTreatmentFee   Float?
  standardFollowUpFee Float?

  // Address breakdown
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postcode       String?
  country        String? @default("Malaysia")
  // ISO 3166-1 alpha-2; null with a valid MyKad IC counts as MY (SST)
  nationality    String?
  // Non-Malaysian buyer ID on e-invoices (MyInvois PASSPORT scheme)
  passportNumber String?

  // Emergency contact breakdown
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Status
  status String? @default("active")

  // Reminder preferences
  reminderChannel   ReminderChannel @default(WHATSAPP)
  preferredLanguage String          @default("en") // "en" | "ms" | "zh"

  // Marketing consent (PDPA + Meta marketing rules): recall and review
  // messages go only to consenting patients. Reminders don't need it.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Assigned to one doctor at a time
  doctorId String
  doctor   User   @relation("PatientDoctor", fields: [doctorId], references: [id])

  visits       Visit[]
  xrays        Xray[]
  appointments Appointment[]
  invoices     Invoice[]
  documents    PatientDocument[]

  packages          PatientPackage[]
  carePlans         CarePlan[]
  appointmentSeries AppointmentSeries[]
  outreach          PatientOutreach[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([doctorId])
  @@index([lastName, firstName])
}

model Visit {
  id        String   @id @default(cuid())
  visitDate DateTime @default(now())

  // Visit classification
  visitType      String? // "initial", "follow_up", "emergency", "reassessment", "discharge"
  chiefComplaint String? // Primary reason for this visit

  // SOAP Notes
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  treatmentNotes String?

  // Clinical findings (structured)
  areasAdjusted       String? // Comma-separated: "C1, C5, T4, L5, SI"
  techniqueUsed       String? // "Gonstead", "Diversified", "Activator", "Thompson", etc.
  subluxationFindings String? // Specific subluxation patterns found

  // Vitals
  bloodPressureSys Int? // mmHg systolic
  bloodPressureDia Int? // mmHg diastolic
  heartRate        Int? // bpm
  weight           Float? // kg
  temperature      Float? // celsius

  // Recommendations
  recommendations String? // Home exercises, ergonomic advice, lifestyle changes
  referrals       String? // External referrals (orthopedist, neurologist, etc.)
  nextVisitDays   Int? // Recommended days until next visit

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("VisitDoctor", fields: [doctorId], references: [id])

  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  xrays         Xray[]
  questionnaire VisitQuestionnaire?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
  @@index([visitType])
  // Patient visit history, newest first.
  @@index([patientId, visitDate])
}

model VisitQuestionnaire {
  id String @id @default(cuid())

  // Recovery scores (0-10 scale)
  painLevel          Int // 0 = no pain, 10 = worst pain
  mobilityScore      Int // 0 = immobile, 10 = full range
  sleepQuality       Int // 0 = no sleep, 10 = perfect sleep
  dailyFunction      Int // 0 = cannot function, 10 = fully functional
  overallImprovement Int // 0 = much worse, 5 = same, 10 = fully recovered

  // Optional text
  patientComments String? // free-form patient feedback

  visitId String @unique
  visit   Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── X-Ray & Annotations ───

model Xray {
  id         String      @id @default(cuid())
  title      String?
  bodyRegion BodyRegion?
  viewType   ViewType?
  status     XrayStatus  @default(UPLOADING)

  // Original upload
  fileUrl  String
  fileName String
  fileSize Int // bytes
  mimeType String // image/jpeg | image/png
  width    Int? // px — set after upload confirmation
  height   Int? // px

  // Thumbnail
  thumbnailUrl String?

  // Calibration
  isCalibrated    Boolean @default(false)
  pixelsPerMm     Float? // computed from calibration reference
  calibrationNote String? // e.g. "25mm coin" — what was used as reference

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("XrayUploader", fields: [uploadedById], references: [id])

  annotations         Annotation[]
  notes               XrayNote[]
  landmarkCorrections AiLandmarkCorrection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([visitId])
  @@index([status])
  @@index([uploadedById])
  // Patient X-ray lists: filter by patient + status, newest first.
  @@index([patientId, status, createdAt])
}

model Annotation {
  id      String  @id @default(cuid())
  label   String?
  version Int     @default(1)

  // Canvas state — the core payload
  canvasState     Json // AnnotationCanvasState
  canvasStateSize Int  @default(0) // byte size of canvasState JSON (for quota tracking)
  shapeCount      Int  @default(0) // canvasState.shapes.length — 0 means nothing drawn (not "annotated")

  // Snapshot
  thumbnailUrl String? // auto-generated preview after save

  // Image adjustment settings applied when this annotation was saved
  imageAdjustments Json? // ImageAdjustments

  // AI analysis results
  aiLandmarks    Json?
  aiMeasurements Json?

  xrayId String
  xray   Xray   @relation(fields: [xrayId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("AnnotationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([xrayId])
  @@index([createdById])
  // Latest annotation for an X-ray (viewer open, multi-view slot load).
  @@index([xrayId, updatedAt])
}

// Captures every (xrayId, landmarkName) pair where the user dragged an AI-
// placed landmark to a different position. Populated whenever an annotation
// is saved: we walk the canvasState shapes, find any landmark with
// `landmarkSource = "manual"` and `landmarkOriginalX/Y` set, and upsert one
// row per landmark.
//
// Purpose: build a labeled dataset of (image, landmark, correctPosition)
// triples for future model improvement (few-shot prompt examples, fine-
// tuning, or an internal small-model). The table is queryable independent
// of the annotation JSON it came from, so analytics + training-data
// extraction can scan it directly without parsing every annotation.
model AiLandmarkCorrection {
  id String @id @default(cuid())

  xrayId String
  xray   Xray   @relation(fields: [xrayId], references: [id], onDelete: Cascade)

  // The user whose drag produced the most recent correction stored here.
  // When multiple users correct the same landmark on the same X-ray, the
  // latest save wins (the row is upserted, not appended). Disagreement
  // between users is acceptable signal loss for v1; if we need it later
  // we can drop the unique constraint and aggregate at training time.
  userId String
  user   User   @relation("AiLandmarkCorrectionUser", fields: [userId], references: [id])

  // Canonical snake_case name from the detect-landmarks contract, e.g.
  // "top_of_femoral_head_1". Stable across schema revisions of the prompt.
  landmarkName String
  // Human-readable label as shown on the canvas at correction time.
  displayName  String

  // Claude's original placement at the time of detection. Frozen — never
  // overwritten across re-corrections, since the goal is to learn the
  // (AI guess) → (truth) delta.
  aiX Float
  aiY Float

  // The user's final position after dragging.
  finalX Float
  finalY Float

  // Image dimensions at correction time. Needed to normalize coordinates
  // for cross-image training (training pipeline divides by these).
  imageWidth  Int
  imageHeight Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([xrayId, landmarkName])
  @@index([landmarkName])
  @@index([userId])
}

model XrayNote {
  id     String @id @default(cuid())
  bodyMd String // markdown / plain text — rendered as plain text in MVP

  xrayId String
  xray   Xray   @relation(fields: [xrayId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("XrayNoteAuthor", fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  @@index([xrayId, createdAt])
  @@index([authorId])
}

// ─── Appointments ───

model Appointment {
  id            String            @id @default(cuid())
  dateTime      DateTime
  duration      Int               @default(30)
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?
  treatmentType TreatmentType?
  room          String? // free text, e.g. "Room 2"
  source        AppointmentSource @default(STAFF)

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  doctorId String
  doctor   User   @relation("AppointmentDoctor", fields: [doctorId], references: [id])

  visit     Visit?
  invoices  Invoice[]
  reminders AppointmentReminder[]
  outreach  PatientOutreach[]

  // Recurring series (Phase 3). Occurrences keep their row when the series is deleted.
  seriesId    String?
  series      AppointmentSeries?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesIndex Int?
  redemptions PackageRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([branchId])
  @@index([doctorId])
  @@index([dateTime])
  @@index([status])
  // Composite for the calendar window query — filters by branch + date range
  // together. Without this Postgres can only use one of the single-column
  // indexes and scans the rest.
  @@index([branchId, dateTime])
  // Per-doctor day/week views and per-patient history both filter by the
  // owner column and sort/range on dateTime.
  @@index([doctorId, dateTime])
  @@index([patientId, dateTime])
  @@index([seriesId])
}

// ─── Billing ───

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  amount        Decimal
  currency      String        @default("MYR")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  lineItems     Json

  // `amount` is the grand total. Tax is snapshotted at issue so later rate
  // changes don't rewrite history; amountPaid is the sum of its payments.
  subtotal   Decimal? @db.Decimal(10, 2)
  taxRate    Decimal? @db.Decimal(5, 2)
  taxAmount  Decimal? @db.Decimal(10, 2)
  taxLabel   String?
  amountPaid Decimal  @default(0) @db.Decimal(10, 2)
  issuedAt   DateTime @default(now())
  // When an issued invoice was cancelled; the accounting journal posts the
  // reversal on this date. Null for a cancelled draft (never in the books).
  cancelledAt DateTime?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Set when this invoice is the sale of a prepaid package (Phase 3).
  packageSale PatientPackage?
  payments    Payment[]

  // LHDN MyInvois: status of the e-invoice covering this invoice (its own
  // document, or the monthly consolidated one it was rolled into).
  einvoiceStatus      EInvoiceStatus       @default(NOT_SUBMITTED)
  einvoiceSubmissions EInvoiceSubmission[] @relation("EInvoiceSubmissionInvoice")
  consolidatedIntoId  String?
  consolidatedInto    EInvoiceSubmission?  @relation("ConsolidatedInvoices", fields: [consolidatedIntoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([branchId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([appointmentId])
  @@index([branchId, einvoiceStatus, issuedAt])
  @@index([consolidatedIntoId])
}

enum PaymentMethod {
  CASH
  CARD
  DUITNOW_QR
  FPX
  EWALLET
  BANK_TRANSFER
  PANEL
}

// A payment (or, when negative, a refund) against an invoice. Deposits,
// instalments and split payments are several rows on one invoice.
model Payment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  reference     String?
  receivedAt    DateTime
  notes         String?
  receiptNumber String        @unique
  refundReason  String?

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  receivedById String?
  receivedBy   User?   @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  einvoiceSubmissions EInvoiceSubmission[]

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([branchId, receivedAt])
}

// ─── Commissions (Phase 8.2) ───

enum CommissionBasis {
  PERCENT_COLLECTED
  FIXED_PER_VISIT
  PERCENT_PACKAGE_SALE
}

/// Per-branch commission rule. doctorId / treatmentType null = all. `rate` is a
/// percent for the PERCENT_* bases and MYR per visit for FIXED_PER_VISIT. The
/// most specific active rule effective at the event date wins (src/lib/commissions.ts).
model CommissionRule {
  id            String          @id @default(cuid())
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctorId      String?
  treatmentType TreatmentType?
  basis         CommissionBasis
  rate          Decimal         @db.Decimal(10, 2)
  effectiveFrom DateTime
  active        Boolean         @default(true)
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, active])
}

// ─── LHDN MyInvois e-invoicing (Phase 8.4) ───

enum EInvoiceStatus {
  NOT_SUBMITTED
  SUBMITTED
  VALID
  INVALID
  CANCELLED
}

enum EInvoiceKind {
  INVOICE
  CREDIT_NOTE
  REFUND_NOTE
  CONSOLIDATED
}

// One document sent (or prepared) for LHDN validation. INVOICE / REFUND_NOTE
// rows point at their invoice (and refund payment); a CONSOLIDATED row covers
// the invoices whose `consolidatedIntoId` points at it.
model EInvoiceSubmission {
  id              String         @id @default(cuid())
  kind            EInvoiceKind
  status          EInvoiceStatus @default(NOT_SUBMITTED)
  // cbc:ID of the document (invoice number, refund receipt number, CONS-…)
  codeNumber      String
  documentVersion String
  documentHash    String
  // The exact JSON that was hashed and base64-encoded for submission
  document        String?        @db.Text
  submissionUid   String?
  uuid            String?
  longId          String?
  errors          Json?
  periodStart     DateTime?
  periodEnd       DateTime?
  submittedAt     DateTime?
  validatedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  lastPolledAt    DateTime?

  invoiceId String?
  invoice   Invoice? @relation("EInvoiceSubmissionInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  consolidatedInvoices Invoice[] @relation("ConsolidatedInvoices")

  createdById String?
  createdBy   User?   @relation("EInvoiceSubmittedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, createdAt])
  @@index([branchId, kind, periodStart])
  @@index([status, lastPolledAt])
  @@index([submissionUid])
  @@index([uuid])
}

// ─── Documents ───

model PatientDocument {
  id       String  @id @default(cuid())
  title    String
  fileUrl  String
  fileName String
  fileSize Int
  mimeType String
  category String?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  uploadedById String

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([uploadedById])
}

// ─── Appointment Reminders ───

model BranchReminderSettings {
  id         String  @id @default(cuid())
  branchId   String  @unique
  branch     Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  enabled    Boolean @default(false)
  offsetsMin Int[]
  templates  Json

  // Outreach (Phase 6): recall of lapsed patients and review requests.
  recallEnabled      Boolean @default(false)
  recallAfterDays    Int     @default(42)
  recallCooldownDays Int     @default(90)
  recallDailyLimit   Int     @default(30)
  reviewEnabled      Boolean @default(false)
  reviewDelayHours   Int     @default(3)
  reviewCooldownDays Int     @default(180)
  googleReviewUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WaSession {
  id          String          @id @default(cuid())
  branchId    String          @unique
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status      WaSessionStatus @default(DISCONNECTED)
  phoneNumber String?
  lastSeenAt  DateTime?
  qrPayload   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// WhatsApp Cloud API connection (Meta). One per branch; replaces the
// Baileys WaSession. See context/features/whatsapp-cloud-api-spec.md.
enum WhatsAppConnectionType {
  COEXISTENCE
  EMBEDDED_SIGNUP
  MANUAL
}

enum WhatsAppAccountStatus {
  CONNECTED
  ERROR
}

model WhatsAppAccount {
  id                 String                 @id @default(cuid())
  branchId           String                 @unique
  branch             Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  wabaId             String
  phoneNumberId      String                 @unique
  displayPhoneNumber String?
  verifiedName       String?
  connectionType     WhatsAppConnectionType
  status             WhatsAppAccountStatus  @default(CONNECTED)
  lastError          String?
  accessTokenEnc     String
  registrationPinEnc String?
  templateName       String
  templateStatus     Json
  templatesCheckedAt DateTime?
  connectedById      String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([wabaId])
}

model AppointmentReminder {
  id            String          @id @default(cuid())
  appointmentId String
  appointment   Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       ReminderChannel
  offsetMin     Int
  scheduledFor  DateTime
  status        ReminderStatus  @default(PENDING)
  sentAt        DateTime?
  failureReason String?
  attemptCount  Int             @default(0)
  externalId    String?
  isFallback    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([appointmentId, channel, offsetMin, isFallback])
  @@index([scheduledFor, status])
  @@index([appointmentId])
}

// ─── Outreach: recall + review requests (Phase 6) ───

enum OutreachType {
  RECALL
  REVIEW
}

enum OutreachStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model PatientOutreach {
  id            String          @id @default(cuid())
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type          OutreachType
  // WHATSAPP or EMAIL only (a fallback switches the row's channel to EMAIL)
  channel       ReminderChannel
  status        OutreachStatus  @default(PENDING)
  scheduledFor  DateTime
  sentAt        DateTime?
  externalId    String?
  failureReason String?
  attemptCount  Int             @default(0)
  // Set for REVIEW (the completed visit it follows up); one review per appointment
  appointmentId String?
  appointment   Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  // null when created by the cron
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([appointmentId, type])
  @@index([branchId, type, status, scheduledFor])
  @@index([patientId, type, createdAt])
  @@index([status, scheduledFor])
  @@index([externalId])
}

// ─── Packages, care plans, recurring series (Phase 3) ───

enum PackageStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum CarePlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Branch catalogue entry — what a package costs and which treatments redeem it.
model PackageTemplate {
  id             String          @id @default(cuid())
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  sessions       Int
  price          Decimal         @db.Decimal(10, 2)
  validityDays   Int?
  /// Empty = any treatment type redeems it.
  treatmentTypes TreatmentType[]
  isActive       Boolean         @default(true)

  patientPackages PatientPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, isActive])
}

/// A package sold to a patient. Name / sessions / price are a snapshot at sale.
model PatientPackage {
  id             String           @id @default(cuid())
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  templateId     String?
  template       PackageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name           String
  sessionsTotal  Int
  sessionsUsed   Int              @default(0)
  price          Decimal          @db.Decimal(10, 2)
  treatmentTypes TreatmentType[]
  purchasedAt    DateTime         @default(now())
  expiresAt      DateTime?
  status         PackageStatus    @default(ACTIVE)
  soldById       String?
  /// Sale invoice (one line: the package).
  invoiceId      String?          @unique
  invoice        Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?

  redemptions PackageRedemption[]
  carePlans   CarePlan[]
  series      AppointmentSeries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
  @@index([branchId, status])
}

/// One session of a package used by an appointment. Reversed rows are kept as
/// history; at most one non-reversed row per appointment (enforced in
/// src/lib/package-service.ts under a row lock on the appointment).
model PackageRedemption {
  id               String         @id @default(cuid())
  patientPackageId String
  patientPackage   PatientPackage @relation(fields: [patientPackageId], references: [id], onDelete: Cascade)
  appointmentId    String
  appointment      Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  redeemedAt       DateTime       @default(now())
  redeemedById     String?
  reversedAt       DateTime?
  reversedById     String?

  @@index([appointmentId, reversedAt])
  @@index([patientPackageId])
}

/// Clinical treatment plan (not visible to front desk).
model CarePlan {
  id               String          @id @default(cuid())
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           User            @relation("CarePlanDoctor", fields: [doctorId], references: [id])
  title            String
  visitsPerWeek    Int
  totalVisits      Int
  startDate        DateTime
  goals            String?
  status           CarePlanStatus  @default(ACTIVE)
  patientPackageId String?
  patientPackage   PatientPackage? @relation(fields: [patientPackageId], references: [id], onDelete: SetNull)

  series AppointmentSeries[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
  @@index([branchId])
}

/// Recurrence rule behind a set of appointments. Weekdays (0 = Sunday) and
/// startTime ("HH:MM") are clinic wall-clock time.
model AppointmentSeries {
  id               String          @id @default(cuid())
  patientId        String
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           User            @relation("SeriesDoctor", fields: [doctorId], references: [id])
  treatmentType    TreatmentType?
  duration         Int
  room             String?
  weekdays         Int[]
  startTime        String
  intervalWeeks    Int             @default(1)
  count            Int?
  until            DateTime?
  startDate        DateTime
  carePlanId       String?
  carePlan         CarePlan?       @relation(fields: [carePlanId], references: [id], onDelete: SetNull)
  patientPackageId String?
  patientPackage   PatientPackage? @relation(fields: [patientPackageId], references: [id], onDelete: SetNull)
  createdById      String?

  appointments Appointment[]

  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([branchId])
  @@index([carePlanId])
}

// ─── Patient portal (Phase 7.2) ───

/// One-time sign-in code sent by email. Only the HMAC of the code is stored.
model PortalLoginCode {
  id         String    @id @default(cuid())
  /// Lowercased.
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// A signed-in portal browser. The cookie holds a random token; only its hash is stored.
/// Covers every Patient row with this email (case-insensitive), across branches.
model PortalSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  /// Lowercased.
  email      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([email])
}
